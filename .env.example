# Server-side only. Never copy secrets into frontend files or commit .env.
# The resource endpoint, NOT the Foundry project endpoint.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
# Name of a deployed chat model supporting JSON output, e.g. a gpt-4.1-mini deployment.
AZURE_OPENAI_DEPLOYMENT=
AI_MAX_ARTICLES_PER_RUN=20
NEWS_UPDATE_MINUTES=15
NEWS_AUTO_UPDATE=1
# In App Service, use a persistent /home path.
# NEWS_DATA_PATH=/home/mynews/news.json
